htmlcov/
.toml
.cache
.pytest_cache/
.hypothesis/
.nosetests
cov-report.xml
.coverage
.coverage.*

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally not be used
#   with risks of version locking; check in Pipfile.lock if it is an app
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be neglected
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be neglected
# pdm.lock

# PEP 582; used by e.g. pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Streamlit logs and configuration
.streamlit/

# Local QuantLab datasets and cache
data/*.csv
data/*.parquet
data/*.json
